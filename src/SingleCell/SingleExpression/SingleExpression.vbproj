<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Erica.Analysis.SingleCell.Expression</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;MEMI-Desktop</Configurations>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <AssemblyName>Erica.Analysis.SingleCell.Expression</AssemblyName>
    <UseApplicationFramework>True</UseApplicationFramework>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <Title>Erica Single-Cell Expression Deep Models (CVAE &amp; Diffusion)</Title>
    <Description>Deep generative models for single-cell gene-expression analysis. Implements a Conditional Variational Autoencoder (CVAE) for single-cell time-series interpolation and a DDPM denoising diffusion probabilistic model for conditional cell-state generation/prediction, together with TCGA MTX data readers and transcription-factor / VCC reference tables.</Description>
    <PackageTags>single-cell deep-learning cvae diffusion-model gene-expression erica</PackageTags>
    <PackageReleaseNotes>Initial NuGet package release (2026). Ships the CVAE module (LinearLayer, LayerNorm, Adam optimizer, encode/decode/reparameterize, InterpolateTimePoint), the Diffusion module (DDPM NoiseScheduler with linear/cosine schedules, conditional generation), and TCGA/AnimalTFDB data helpers.</PackageReleaseNotes>
    <PackageIcon>icons8-jellyfish-96.png</PackageIcon>
    <PackageProjectUrl>https://github.com/SMRUCC/Erica</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SMRUCC/Erica.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © SMRUCC genomics, GuiLin China, 2026</Copyright>
    <Authors>xieguigang@metabolomics.ac.cn</Authors>
    <Company>SMRUCC genomics institute</Company>
    <Product>Erica</Product>
  </PropertyGroup>

